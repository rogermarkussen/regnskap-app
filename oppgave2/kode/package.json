{
  "name": "regnskap-oppgave2-kontogruppering",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare:data": "uv run python scripts/prepare_data.py",
    "validate": "uv run python scripts/validate_task2.py",
    "test:excel": "uv run python -m unittest tests.test_task2_excel_fasit tests.test_task2_grouping_fasit -v",
    "test:export": "node --test tests/task2_excel_export.test.js",
    "report": "uv run python scripts/build_task2_comparison_html.py",
    "build:web": "uv run python ../../scripts/clean_static_build.py . && vite build",
    "build:public:web": "python ../../scripts/clean_static_build.py . && PUBLIC_BUILD=true vite build",
    "verify:public": "python ../../scripts/verify_static_build.py oppgave2 . --profile public",
    "build:public": "npm run build:public:web && npm run verify:public",
    "verify:production": "uv run python ../../scripts/verify_static_build.py oppgave2 . --profile internal",
    "build": "npm run prepare:data && npm run validate && npm run build:web && npm run verify:production",
    "refresh": "npm test && npm run build:web && npm run verify:production",
    "test:model": "node --test tests/report_model.test.js",
    "test": "npm run prepare:data && npm run validate && npm run test:excel && npm run test:export && npm run test:model",
    "dev:fast": "npm run prepare:data && vite --host 0.0.0.0 --port 3001",
    "preview": "vite preview --host 0.0.0.0 --port 3001"
  },
  "engines": { "node": ">=22 <23" },
  "type": "module",
    "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "svelte": "5.56.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "fflate": "^0.8.3",
    "vite": "8.2.2"
  }
}
